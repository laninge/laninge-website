# Copy to .env.local for local development (ignored by git).
# For production, set these as Vercel Project Environment Variables.

# Claude API — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Voyage AI embeddings — https://www.voyageai.com/
VOYAGE_API_KEY=

# Upstash Redis (rate limit + query cache) — https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local-only: path to the Substack export "posts" folder.
# Used by `npm run build:embeddings`. Not needed on Vercel.
NEWSLETTERS_DIR=
